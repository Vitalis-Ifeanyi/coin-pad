# Optional. A free CoinGecko "Demo" key raises the rate limit from the shared
# keyless pool to a steady 30 calls/min. Get one at
# https://www.coingecko.com/en/api/pricing, then copy this file to .env.local.
# On Vercel, add it under Project → Settings → Environment Variables.
VITE_COINGECKO_DEMO_KEY=
